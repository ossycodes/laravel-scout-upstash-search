{
    "name": "ossycodes/laravel-scout-upstash-search",
    "description": "A Laravel Scout engine for Upstash Search",
    "keywords": ["laravel", "scout", "upstash", "search", "ai", "semantic", "vector"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/scout": "^9.0 || ^10.0 || ^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "orchestra/testbench": "^8.0 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelUpstashSearch\\Scout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelUpstashSearch\\Scout\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelUpstashSearch\\Scout\\UpstashSearchServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
